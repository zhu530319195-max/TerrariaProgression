    TalentHints: {
  "MaxLife": "+25 HP per level. Raising the maximum never heals; lowering it only clips current life.",
  "MaxMana": "+20 MP per level. Raising the maximum never restores mana.",
  "Defense": "+4 defense per level, additive with equipment.",
  "MoveSpeed": "+5% running speed per level, multiplied after equipment. Mount movement follows native rules.",
  "Acceleration": "+5% running acceleration per level, multiplied after equipment.",
  "LifeRegen": "+1 HP/sec per level through native life regeneration and its status rules.",
  "NaturalLifeRegen": "+10% natural life regeneration per level; multiplies the native natural component.",
  "ManaRegen": "+2 MP/sec per level, independent of natural mana regeneration delay.",
  "NaturalManaRegen": "+10% natural mana regeneration per level; supplements the native computed rate and preserves its delay.",
  "Healing": "+5% healing item restoration per level. Heart pickup restoration is a separate future talent.",
  "ManaRestoration": "+5% mana item restoration per level. Mana stars are a separate future talent.",
  "Damage": "+5% generic damage per level, additive with equipment damage bonuses.",
  "AttackSpeed": "+3% attack speed per level; respects weapon inheritance and tick timing.",
  "CritDamage": "Adds 0.05 critical multiplier per level. Level 10 changes native ×2 crits to ×2.5.",
  "ArmorPenetration": "+3 armor penetration per level through Generic DamageClass inheritance.",
  "Knockback": "+10% knockback per level, additive with equipment; respects enemy immunity.",
  "AmmoSaving": "Ammo consumption chance ×0.93 per level, multiplicative with native conservation.",
  "ManaSaving": "Mana cost ×0.95 per level, multiplicative with native modifiers.",
  "Minions": "+1 minion capacity per level, additive with equipment.",
  "Sentries": "+1 sentry capacity per level, additive with equipment.",
  "PickupRange": "+10% pickup range per level, multiplied with the original item range.",
  "CritChance": "Adds 10 percentage points per level. Above 100%: tier 1 x2, tier 2 x3, tier 3 x4. Respects DisableCrit and standard crit classes.",
  "BagQuantity": "+10% contents per level when opening vanilla Boss bags or fishing crates. Equipment duplicates are separate items. Uses the opener, with probabilistic fractional quantities. Does not affect world chests.",
  "DropChance": "+10% extra rolls per level: level 10 adds one roll, level 20 adds two. Fractional rolls are probabilistic. Independent rolls can repeat rewards and stack with quantity. Native supported rules; per-event budget applies.",
  "MeleeRange": "Adds 10% native swing, vanilla shortsword thrust and spear size/reach per level. Sword beams, whips, yoyos and unknown modded projectiles are not enlarged. Active level is adjustable.",
  "ToolReach": "Adds 1 tile of pick/axe/hammer reach per level. Does not change power, speed or tile count. Adjustable.",
  "BuildReach": "Adds 1 tile of tile/wall placement reach per level, separately from tool reach. Adjustable.",
  "PotionDuration": "New Potion Sickness duration x0.93 per level; stacks with Debuff Duration. Existing timers are not rescaled.",
  "DebuffDuration": "New debuff duration x0.95 per level, at least 1 tick. Continuous sources can refresh debuffs.",
  "LootQuantity": "Adds 10% quantity per level to successful NPC loot; fractional tail is probabilistic. Native loot recipient, server category controls.",
  "Coins": "Adds 10% NPC coin output per level using native loot attribution; no bonus on ordinary pickups or discarded coins.",
  "MiningYield": "Adds 10% attributed Ore-tagged tile yield per level. Unowned environmental breaks are excluded.",
  "WoodYield": "Adds 10% attributed tree wood output per level. Does not fell additional blocks.",
  "HerbYield": "Adds 10% attributed vanilla herb plant output including seeds per level. Unknown plants need an adapter.",
  "GemYield": "Adds 10% attributed output of the seven vanilla gems, including gem trees.",
  "FishingYield": "Adds 10% caught item quantity per level. Uses native owner-client fishing; no quest or container bonus.",
  "SellPrice": "Adds 5% coin selling price per level after happiness. Special currencies unchanged.",
  "BuyDiscount": "Coin buying price x0.95 per level after native modifiers. Nonfree goods cost at least 1 copper.",
  "ReforgeDiscount": "Reforge price basis x0.95 per level; native final discounts and rounding remain.",
  "JumpSpeed": "Adds 3% native jump speed per level after equipment. Custom movement may override it.",
  "Breath": "Adds 10% breath capacity per level. Raising the maximum does not refill breath.",
  "KnockbackResistance": "Incoming knockback x0.95 per level. Preserves immunity.",
  "HeartRecovery": "Adds 10% healing from vanilla hearts and seasonal equivalents per level.",
  "StarRecovery": "Adds 10% restoration from vanilla mana stars and equivalents per level.",
  "ProjectileSpeed": "Adds 5% launch velocity per level. Projectile AI can override velocity.",
  "Invulnerability": "Adds 1 frame to the applicable native hurt immunity timer per level."
}
    Messages: {
      LootLimit: "Extra loot reached the roll budget or item capacity; some extra rewards were not generated. Adjust the roll budget in Mod Config. Levels and points are unchanged."
      Status: "Level {0} | XP {1} / {2} | Total XP {3} | Available talent points {4} | Spent {5}"
      Waiting: "Waiting for the server to confirm character progression."
      DebugDisabled: "Enable developer commands in the mod configuration first."
      ConsoleOnly: "Multiplayer XP testing is restricted to the dedicated server console."
      ServerConfigLocked: "Set progression rules before hosting, or edit the dedicated server config and restart."
    }
    Configs: {
      ProgressionConfig: {
        DisplayName: Progression rules (server)
        MaxExtraLootRollsPerEvent: { Label: "Extra rolls per event budget", Tooltip: "Default 1000; range 1-100000. Stops excess rolls with a notice, without changing levels or points. Larger budgets may cause stalls." }
        BoostMaterials: { Label: "Boost Materials", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostConsumables: { Label: "Boost Consumables", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostPotions: { Label: "Boost Potions", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostAmmo: { Label: "Boost Ammo", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostWeapons: { Label: "Boost Weapons", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostArmor: { Label: "Boost Armor", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostAccessories: { Label: "Boost Accessories", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostBossLoot: { Label: "Boost BossLoot", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostTreasureBags: { Label: "Boost TreasureBags", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostMounts: { Label: "Boost Mounts", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostPets: { Label: "Boost Pets", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostModItems: { Label: "Boost ModItems", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        HpToXpMultiplier: {
          Label: XP per maximum HP
          Tooltip: "NPC.lifeMax × this multiplier. Range 0.01–10.00."
        }
        ExperienceRequirementCap: {
          Label: XP requirement cap per level
          Tooltip: "Default 50000. 0 = uncapped. Character levels remain unlimited."
        }
        StatueExperienceMultiplier: {
          Label: Statue NPC experience multiplier
          Tooltip: "0 = none; 0.5 = half; 1 = normal; 2 = double. Range 0–10."
        }
        EnableDebugCommands: {
          Label: Enable developer commands
          Tooltip: "Enables /tpgivexp in singleplayer and tpgivexp in the server console. Does not permit multiplayer clients to grant XP."
        }
        LogExperienceSettlements: {
          Label: Log experience settlements
          Tooltip: "Records grouped NPC count, lifeMax, XP shares and recipient slots to client.log/server.log."
        }
      }
    }
  }
}
