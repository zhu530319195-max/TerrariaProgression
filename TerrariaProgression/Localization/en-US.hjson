    TalentHints: {
  "MaxLife": "+25 HP per level. Raising the maximum never heals; lowering it only clips current life.",
  "MaxMana": "+20 MP per level. Raising the maximum never restores mana.",
  "Defense": "+4 defense per level, additive with equipment.",
  "MoveSpeed": "+5% running speed per level, multiplied after equipment. Mount movement follows native rules.",
  "Acceleration": "+5% running acceleration per level, multiplied after equipment.",
  "LifeRegen": "+1 HP/sec per level through native life regeneration and its status rules.",
  "NaturalLifeRegen": "+10% natural life regeneration per level; multiplies the native natural component.",
  "ManaRegen": "+2 MP/sec per level, independent of natural mana regeneration delay.",
  "NaturalManaRegen": "+10% natural mana regeneration per level; supplements the native computed rate and preserves its delay.",
  "Healing": "+5% healing item restoration per level. Heart pickup restoration is a separate future talent.",
  "ManaRestoration": "+5% mana item restoration per level. Mana stars are a separate future talent.",
  "Damage": "+5% generic damage per level, additive with equipment damage bonuses.",
  "AttackSpeed": "+3% attack speed per level; respects weapon inheritance and tick timing.",
  "CritDamage": "Adds 0.05 critical multiplier per level. Level 10 changes native ×2 crits to ×2.5.",
  "ArmorPenetration": "+3 armor penetration per level through Generic DamageClass inheritance.",
  "Knockback": "+10% knockback per level, additive with equipment; respects enemy immunity.",
  "AmmoSaving": "Ammo consumption chance ×0.93 per level, multiplicative with native conservation.",
  "ManaSaving": "Mana cost ×0.95 per level, multiplicative with native modifiers.",
  "Minions": "+1 minion capacity per level, additive with equipment.",
  "Sentries": "+1 sentry capacity per level, additive with equipment.",
  "AreaMining": "Radius +1 tile per level: Lv1 3x3, Lv10 21x21; adjustable. Hold the gathering key (Left Alt by default) and mine the first tile normally. G switches area/vein mode. Respects pick power and server protection. Changing tools or talents stops the job.",
  "VeinMining": "Up to 25 same-type connected ore tiles per level, including the first tile; Lv10 250. Adjustable. Hold Left Alt and select vein mode with G. Diagonal connections count, gaps do not. Mod ores require server opt-in and an ore flag.",
  "TreeFelling": "One-time 2 points. Hold Left Alt with an axe and chop a native tree trunk; finish the same tree including its remaining stump. No neighbouring trees or wooden buildings. Keeps wood/gem yield. Refuses protected or over-budget trees. Excludes mod trees, giant mushrooms, cactus and bamboo.",
  "PickupRange": "+10% pickup range per level, multiplied with the original item range.",
  "CritChance": "Adds 10 percentage points per level. Above 100%: tier 1 x2, tier 2 x3, tier 3 x4. Respects DisableCrit and standard crit classes.",
  "BagQuantity": "+10% contents per level when opening vanilla Boss bags or fishing crates. Equipment duplicates are separate items. Uses the opener, with probabilistic fractional quantities. Does not affect world chests.",
  "DropChance": "+10% extra rolls per level: level 10 adds one roll, level 20 adds two. Fractional rolls are probabilistic. Independent rolls can repeat rewards and stack with quantity. Native supported rules; per-event budget applies.",
  "MeleeRange": "+10% per level to swings, native shortswords/spears, whip length and flail spin/throw reach; adjustable. Matching visible/hit geometry. Extreme flail output saturates below the native 900 px cleanup boundary. Excludes sword beams, yoyos and unknown mod projectiles.",
  "ToolReach": "Adds 1 tile of pick/axe/hammer reach per level. Does not change power, speed or tile count. Adjustable.",
  "BuildReach": "Adds 1 tile of tile/wall placement reach per level, separately from tool reach. Adjustable.",
  "PotionDuration": "New Potion Sickness duration x0.93 per level; stacks with Debuff Duration. Existing timers are not rescaled.",
  "DebuffDuration": "New debuff duration x0.95 per level, at least 1 tick. Continuous sources can refresh debuffs.",
  "LootQuantity": "Adds 10% quantity per level to successful NPC loot; fractional tail is probabilistic. Native loot recipient, server category controls.",
  "Coins": "Adds 10% NPC coin output per level using native loot attribution; no bonus on ordinary pickups or discarded coins.",
  "MiningYield": "Adds 10% attributed Ore-tagged tile yield per level. Unowned environmental breaks are excluded.",
  "WoodYield": "Adds 10% attributed tree wood output per level. Does not fell additional blocks.",
  "HerbYield": "Adds 10% attributed vanilla herb plant output including seeds per level. Unknown plants need an adapter.",
  "GemYield": "Adds 10% attributed output of the seven vanilla gems, including gem trees.",
  "FishingYield": "Adds 10% caught item quantity per level. Uses native owner-client fishing; no quest or container bonus.",
  "SellPrice": "Adds 5% coin selling price per level after happiness. Special currencies unchanged.",
  "BuyDiscount": "Coin buying price x0.95 per level after native modifiers. Nonfree goods cost at least 1 copper.",
  "ReforgeDiscount": "Reforge price basis x0.95 per level; native final discounts and rounding remain.",
  "JumpSpeed": "Adds 3% native jump speed per level after equipment. Custom movement may override it.",
  "Breath": "Adds 10% breath capacity per level. Raising the maximum does not refill breath.",
  "KnockbackResistance": "Incoming knockback x0.95 per level. Preserves immunity.",
  "HeartRecovery": "Adds 10% healing from vanilla hearts and seasonal equivalents per level.",
  "StarRecovery": "Adds 10% restoration from vanilla mana stars and equivalents per level.",
  "ProjectileSpeed": "Adds 5% launch velocity per level. Projectile AI can override velocity.",
  "Invulnerability": "Adds 1 frame to the applicable native hurt immunity timer per level.",
  "NoFallDamage": "Prevents native fall damage without duplicating equipment effects.",
  "MultiJump": "Adds one extra midair jump per level, stacking with equipment jumps. Adjustable count. Release and press jump again. Native ground/grapple refresh restores uses; toggling midair does not.",
  "WaterWalking": "Walk on water and honey; press down to sink. Does not grant lava walking or immunity.",
  "LavaWalking": "Walk on lava under normal gravity; does not grant water walking or lava immunity. Lava contact can still hurt.",
  "UnderwaterBreathing": "Pauses drowning without refilling breath. Disabling resumes from current breath; avoids special-seed air drowning.",
  "LavaImmunity": "Prevents native lava damage. Does not grant lava walking or all debuff immunities.",
  "HotTileImmunity": "Protects against native hot-tile contact, not every fire attack.",
  "KnockbackImmunity": "Prevents native hit knockback. Disabling retains real equipment immunity.",
  "AllInformation": "Unlocks 12 native information/treasure effects. Toggle each below at no cost. Disabling removes only talent contributions, not equipment or team information.",
  "ToolSpeed": "Tool intervals divided by (1 + 0.2 x active level); level 10 is about 3x efficiency. Native picks, axes and hammers; preserves tool power, protection and placement speed. Minimum one frame.",
  "Dash": "Double-tap left/right for a native standard dash, with native cooldown/collision and no damage or dodge. Existing equipment dash takes priority. Disabling does not reset an active dash or cooldown.",
  "WallClimb": "Hold toward a wall to cling; press jump repeatedly to climb by wall-jumping. Down slides. Cling takes priority over the slide talent. Native rules, no phasing or rope-style climbing.",
  "WallSlide": "Hold toward a wall to descend slowly; down descends faster. Wall-jumping is supported. Existing cling equipment or Wall Climb takes priority.",
  "UnlimitedFlight": "Conserves remaining flight time of existing wings without granting wings or speed. No mounts or standalone rocket boots. If already exhausted, land once first. Disabling does not refill time.",
  "IceTraction": "Native ice traction improves starting, braking and turning. Does not stack twice with ice skates.",
  "BuildingRuler": "Enables native grid/ruler display controls. Select displays using the vanilla builder buttons beside inventory. Preserves the built-in ruler and your button preferences.",
  "AutoPaint": "Uses inventory paint while placing tiles, furniture and walls, with native consumption. Enable the vanilla paint builder button. Building still works without paint; existing buildings are not repainted automatically.",
  "FishingLine": "Prevents native line-break loss on retrieval. Bait consumption and normal fishing requirements remain. Does not guarantee a catch on every cast.",
  "LavaFishing": "Allows ordinary rods and bait to fish in a sufficiently large lava pool. Normal fishing power, waiting and consumption apply. Does not grant lava immunity.",
  "StatusImmunity": "Two points unlock 13 native status immunities, each freely toggleable. Equipment immunity remains. Excludes potion sickness, chaos state, moon leech, lava damage and unknown mod debuffs. Native immunity cleanup removes covered active statuses.",
  "StarRetaliation": "Native retaliation damage x active level (level 1 normal, level 10 x10). A survived eligible hit spawns three native stars; count never grows. Existing cloak retaliation is strengthened instead of duplicated. Adjustable strength and native damage-channel rules.",
  "BeeRetaliation": "Native retaliation bee damage x active level (level 1 normal, level 10 x10). A survived hit spawns the native 1-3 bees; real strong-bee effects can add one. Existing honey-comb retaliation is strengthened instead of duplicated. Talent does not grant Honey healing.",
  "PanicSpeed": "A real hit grants native Panic for 8 seconds (+100% movement-speed bonus). Does not stack twice with a Panic Necklace. Enabling does not trigger it. An already triggered buff expires naturally after disabling.",
  "AfflictionDamage": "Adds 20% damage per active level to talent-applied On Fire, Poisoned, Frostburn, Cursed Inferno and Venom (3x native base DoT at level 10). Only valid talent source leases qualify, not weapon-only, environment or unknown mod statuses. No extra Ichor defense reduction. Multiple players use the highest currently valid bonus per status. Intensity changes apply live; disable/refund stops the bonus without clearing native debuffs.",
  "AttackFrostburn": "Applies native Frostburn for 2 seconds per active level (20 seconds at level 10) on effective weapon, owned projectile and minion hits. Respects native immunity/coexistence; refreshes to the longer duration, never sums. Adjustable. Disabling stops new applications without clearing existing buffs. Talent-sourced DoT can be boosted by Affliction Damage.",
  "AttackCursedInferno": "Applies native Cursed Inferno for 2 seconds per active level (20 seconds at level 10) on effective weapon, owned projectile and minion hits. Respects native immunity/coexistence; refreshes to the longer duration, never sums. Adjustable. Disabling stops new applications without clearing existing buffs. Talent-sourced DoT can be boosted by Affliction Damage.",
  "AttackVenom": "Applies native Venom for 2 seconds per active level (20 seconds at level 10) on effective weapon, owned projectile and minion hits. Respects native immunity/coexistence; refreshes to the longer duration, never sums. Adjustable. Disabling stops new applications without clearing existing buffs. Talent-sourced DoT can be boosted by Affliction Damage.",
  "AttackIchor": "Applies native Ichor for 2 seconds per active level (20 seconds at level 10) on effective weapon, owned projectile and minion hits. Respects native immunity/coexistence; refreshes to the longer duration, never sums. Adjustable. Disabling stops new applications without clearing existing buffs. Ichor defense reduction stays native and is unaffected by Affliction Damage.",
  "FishingPower": "Adds 5 base fishing power per active level (+50 at level 10). Adds to equipment power before native weather/time multipliers. Adjustable; disabling or zero intensity removes the contribution. Does not provide a rod or bait.",
  "AttackBurn": "Applies native On Fire for 2 seconds per active level (20 seconds at level 10). Melee, projectiles and minions use current active strength. Refreshes to the longer duration; never adds durations. Respects enemy immunity, duration talent retains native DPS; talent-sourced damage can be boosted by Affliction Damage, excludes PvP/friendly NPCs.",
  "AttackPoison": "Applies native Poisoned for 2 seconds per active level (20 seconds at level 10). Melee, projectiles and minions use current active strength. Refreshes to the longer duration; never adds durations. Respects enemy immunity, duration talent retains native DPS; talent-sourced damage can be boosted by Affliction Damage, excludes PvP/friendly NPCs.",
  "FlightTime": "+1 second of existing wing capacity per level; +10s at Lv.10. Adjustable. No wings, mount flight or rocket boots granted. Raising capacity never refills airborne fuel; native landing does. Works with Unlimited Flight.",
  "FlightSpeed": "+5% existing wing horizontal speed/acceleration and standard ascent parameters per level. Adjustable; Lv.10 +50%. Special hover modes may have separate rules. No running or mount bonus. Extreme parameters use finite engine limits.",
  "SwimSpeed": "+10% movement in ordinary water per level; Lv.10 doubles it. Adjustable. Native collision is retained with no exponential acceleration, including native merman/ignoreWater paths. No swimming jumps or breathing granted. Excludes other liquids, mounts, grappling and dashes. Extreme motion limited to 256 pixels per axis per tick.",
  "PlacementSpeed": "+20% placement speed per level; Lv.10 is 3x speed. Adjustable. Uses ordinary placeable tile/furniture/torch metadata; no weapon/mining bonus, material savings or range change. Stacks with native building gear; minimum one tick.",
  "WallPlacementSpeed": "+20% wall placement speed per level; Lv.10 is 3x speed. Adjustable independently of tiles. No demolition bonus or material savings; native placement conditions apply; minimum one tick.",
  "NightVision": "2-point native night vision toggle. Does not emit light. Turning off preserves equipment/potion night vision.",
  "SelfLight": "2-point moving light using native Shine potion light strength/color. Independent toggle, no buff slot or healing.",
  "DangerSense": "2-point native dangersense toggle for recognized hazards and traps. Not a full wire view; unknown mod traps are not guaranteed. Turning off preserves real potion effects.",
  "BaitSaving": "Original bait consumption probability ×0.93 per active level; Lv.10 saves about 51.6%. Stacks with native conservation and never forces consumption. Rod, bait and fishing conditions remain. Applies to valid bait including special bait. Adjustable.",
  "CrateChance": "Original crate-gate failure probability ×0.95 per active level. A 10% gate becomes about 46.1% at Lv.10. Only changes crate eligibility; native rarity, biome, quests, enemies, pond and liquid rules remain. Honey is skipped; lava retains extra selection, so final crate yield can differ. Adjustable."
}
    Messages: {
      GatheringMode: "Gathering mode: {0}. Hold the gathering key. Axes select tree felling automatically."
      GatheringBlocked: "Gathering blocked: check server permission, protection, tool, reach or the whole-tree budget."
      GatheringLimit: "Gathering reached the action limit; talent levels and paid points are unchanged."

      LootLimit: "Extra loot reached the roll budget or item capacity; some extra rewards were not generated. Adjust the roll budget in Mod Config. Levels and points are unchanged."
      Status: "Level {0} | XP {1} / {2} | Total XP {3} | Available talent points {4} | Spent {5}"
      Waiting: "Waiting for the server to confirm character progression."
      DebugDisabled: "Enable developer commands in the mod configuration first."
      ConsoleOnly: "Multiplayer XP testing is restricted to the dedicated server console."
      ServerConfigLocked: "Set progression rules before hosting, or edit the dedicated server config and restart."
    }
    Configs: {
      ProgressionConfig: {
        DisplayName: Progression rules (server)
        EnableWorldGathering: { Label: "EnableWorldGathering", Tooltip: "Server-controlled P3 gathering permission. See the gathering talent description." }
        EnableAreaMining: { Label: "EnableAreaMining", Tooltip: "Server-controlled P3 gathering permission. See the gathering talent description." }
        EnableVeinMining: { Label: "EnableVeinMining", Tooltip: "Server-controlled P3 gathering permission. See the gathering talent description." }
        EnableTreeFelling: { Label: "EnableTreeFelling", Tooltip: "Server-controlled P3 gathering permission. See the gathering talent description." }
        EnableModOreMining: { Label: "EnableModOreMining", Tooltip: "Server-controlled P3 gathering permission. See the gathering talent description." }
        MaxBlocksPerAction: { Label: "MaxBlocksPerAction", Tooltip: "Default 1000 including origin; 0 is unlimited total work. Not a talent level cap. Trees exceeding the limit are refused." }
        GatheringWorkPerTick: { Label: "GatheringWorkPerTick", Tooltip: "Default 32, range 1-256. Global work budget shared fairly by all players, including unlimited jobs." }
        ProtectedTileAreas: { Label: "ProtectedTileAreas", Tooltip: "Tile-coordinate rectangles. X/Y is top-left, Width/Height is size. Protects this mod batch operations only. Use /tpgather coords for cursor coordinates." }
        MaxExtraLootRollsPerEvent: { Label: "Extra rolls per event budget", Tooltip: "Default 1000; range 1-100000. Stops excess rolls with a notice, without changing levels or points. Larger budgets may cause stalls." }
        BoostMaterials: { Label: "Boost Materials", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostConsumables: { Label: "Boost Consumables", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostPotions: { Label: "Boost Potions", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostAmmo: { Label: "Boost Ammo", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostWeapons: { Label: "Boost Weapons", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostArmor: { Label: "Boost Armor", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostAccessories: { Label: "Boost Accessories", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostBossLoot: { Label: "Boost BossLoot", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostTreasureBags: { Label: "Boost TreasureBags", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostMounts: { Label: "Boost Mounts", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostPets: { Label: "Boost Pets", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        BoostModItems: { Label: "Boost ModItems", Tooltip: "Allow NPC loot quantity/chance boosts for this category. Enabled by default." }
        TalentPointsPerLevel: { Label: "Talent points per level", Tooltip: "Enter a nonnegative whole number; default 1, no gameplay cap. 0 disables future awards. No retroactive changes. Invalid input falls back to 1." }
        HpToXpMultiplier: {
          Label: XP per maximum HP
          Tooltip: "NPC.lifeMax × this multiplier. Range 0.01–10.00."
        }
        ExperienceRequirementCap: {
          Label: XP requirement cap per level
          Tooltip: "Default 50000. 0 = uncapped. Character levels remain unlimited."
        }
        StatueExperienceMultiplier: {
          Label: Statue NPC experience multiplier
          Tooltip: "0 = none; 0.5 = half; 1 = normal; 2 = double. Range 0–10."
        }
        EnableDebugCommands: {
          Label: Enable developer commands
          Tooltip: "Enables /tpgivexp in singleplayer and tpgivexp in the server console. Does not permit multiplayer clients to grant XP."
        }
        LogExperienceSettlements: {
          Label: Log experience settlements
          Tooltip: "Records grouped NPC count, lifeMax, XP shares and recipient slots to client.log/server.log."
        }
      }
    }
  }
}

