    TalentHints: {
  "MaxLife": "每级 +25 HP。提高上限不会补血；降低上限仅截断当前生命。",
  "MaxMana": "每级 +20 MP。提高上限不会补魔；降低上限仅截断当前魔力。",
  "Defense": "每级 +4 防御，与装备加算。",
  "MoveSpeed": "每级 +5% 跑步速度，乘算于装备后的速度；坐骑仍受原版运动规则影响。",
  "Acceleration": "每级 +5% 跑步加速度，乘算于装备后的加速度。",
  "LifeRegen": "每级 +1 HP/秒，加入原版生命恢复；受原版恢复状态影响。",
  "NaturalLifeRegen": "每级 +10% 自然回血，乘算原版自然恢复部分。",
  "ManaRegen": "每级 +2 MP/秒，独立于自然回魔延迟。",
  "NaturalManaRegen": "每级 +10% 自然回魔，按原版实际回魔速度补充；保留回魔延迟。",
  "Healing": "每级 +5% 物品治疗量；红心拾取属于后续独立天赋。",
  "ManaRestoration": "每级 +5% 物品回魔量；魔力星属于后续独立天赋。",
  "Damage": "每级 +5% 全局伤害，与装备伤害加成加算。",
  "AttackSpeed": "每级 +3% 攻速；遵循武器的攻速继承和帧数限制。",
  "CritDamage": "每级增加 0.05 暴击倍率。10 级令原版 ×2 暴击变为 ×2.5。",
  "ArmorPenetration": "每级 +3 护甲穿透，使用通用伤害类型继承。",
  "Knockback": "每级 +10% 击退强度，与装备加算；不改变敌人的击退免疫。",
  "AmmoSaving": "每级令弹药消耗概率 ×0.93，与原版节约效果相乘。",
  "ManaSaving": "每级令魔力消耗 ×0.95，与原版耗魔修正相乘。",
  "Minions": "每级 +1 召唤物容量，与装备加算。",
  "Sentries": "每级 +1 哨兵容量，与装备加算。",
  "PickupRange": "每级 +10% 拾取范围，乘算物品原有范围。"
}
    Messages: {
      Status: "等级 {0}｜当前经验 {1} / {2}｜累计经验 {3}｜可用天赋点 {4}｜已投入 {5}"
      Waiting: "正在等待服务器确认角色成长数据。"
      DebugDisabled: "请先在本 MOD 配置中开启“开发测试命令”。"
      ConsoleOnly: "联机添加经验仅允许在专用服务器控制台执行。"
      ServerConfigLocked: "请在开服前设置成长规则；专用服务器请修改配置文件后重启。"
    }
    Configs: {
      ProgressionConfig: {
        DisplayName: 成长规则（服务器）
        HpToXpMultiplier: {
          Label: 每点最大生命对应经验
          Tooltip: "使用 NPC.lifeMax 计算，范围 0.01～10.00。"
        }
        ExperienceRequirementCap: {
          Label: 单级所需经验上限
          Tooltip: "默认 50000；0 表示不封顶。角色等级始终不设游戏上限。"
        }
        StatueExperienceMultiplier: {
          Label: 雕像生成单位经验倍率
          Tooltip: "0 不给经验；0.5 一半；1 正常；2 双倍。范围 0～10。"
        }
        EnableDebugCommands: {
          Label: 开发测试命令
          Tooltip: "默认关闭。开启后可单人使用 /tpgivexp，或由专用服务器控制台添加经验；联机普通客户端仍禁止。"
        }
        LogExperienceSettlements: {
          Label: 记录经验结算日志
          Tooltip: "在 client.log / server.log 记录分组数量、最大生命、分配经验和玩家槽位，用于排查联机或多节 Boss。"
        }
      }
    }
  }
}
