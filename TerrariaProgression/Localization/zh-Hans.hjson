        EnableModOreMining: { Label: "允许MOD矿石连锁", Tooltip: "默认关闭；仅尝试带原生矿石标记的MOD方块，仍检查其正常镐力和破坏规则，不保证所有MOD兼容。" }
        MaxBlocksPerAction: { Label: "单次采集方块上限", Tooltip: "默认1000，包含第一格；0为总量不限。不是天赋等级上限。整树超过上限时拒绝启动。" }
        GatheringWorkPerTick: { Label: "每帧采集处理预算", Tooltip: "默认32，所有玩家共用，范围1～256。检查候选格或敲击一次消耗一个单位；0总量不限仍按此预算处理。" }
        ProtectedTileAreas: { Label: "采集保护区域", Tooltip: "方块坐标矩形，X/Y为左上角，Width/Height为宽高；仅保护本MOD批量采集。可用 /tpgather coords 查看鼠标方块坐标。" }
        MaxExtraLootRollsPerEvent: { Label: "单次额外抽取保护", Tooltip: "默认 1000 次，范围 1～100000。达到上限时停止本次额外抽取并提示，不限制等级，不扣点数。较高设置会增加卡顿风险。" }
        BoostMaterials: { Label: "允许增益：普通材料", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostConsumables: { Label: "允许增益：消耗品", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostPotions: { Label: "允许增益：药水", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostAmmo: { Label: "允许增益：弹药", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostWeapons: { Label: "允许增益：武器", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostArmor: { Label: "允许增益：护甲", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostAccessories: { Label: "允许增益：饰品", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostBossLoot: { Label: "允许增益：Boss 掉落", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostTreasureBags: { Label: "允许增益：宝藏袋", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostMounts: { Label: "允许增益：坐骑", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostPets: { Label: "允许增益：宠物", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        BoostModItems: { Label: "允许增益：MOD 物品", Tooltip: "控制怪物掉落数量／掉率天赋是否作用于此分类；默认开启。" }
        TalentPointsPerLevel: { Label: "每级获得天赋点", Tooltip: "直接填写非负整数，默认1，无玩法数值上限；0为停止发点。仅影响今后升级，不追溯补发或扣除旧点数。不支持小数、负数或科学记数法，输入无效恢复1。" }
        HpToXpMultiplier: {
          Label: 每点最大生命对应经验
          Tooltip: "使用 NPC.lifeMax 计算，范围 0.01～10.00。"
        }
