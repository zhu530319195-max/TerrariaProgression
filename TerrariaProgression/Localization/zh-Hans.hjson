        EnableTreeFelling: { Label: "允许一键伐木", Tooltip: "仅原版树；不砍相邻树和木材建筑。" }
        EnableAreaHarvest: { Label: "允许范围收割", Tooltip: "仅当前能产种子的原版草药，保留种植容器和支撑。" }
        EnableBlastRadius: { Label: "允许爆破范围增强" Tooltip: "仅控制额外地形扩展，同时受采集总开关、保护区和预算限制。原版爆炸保持原样。" }
