<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TmlInstallPath Condition="'$(TmlInstallPath)' == '' and '$(TML_PATH)' != ''">$(TML_PATH)</TmlInstallPath>
  </PropertyGroup>
  <Import Project="$(TmlInstallPath)/tMLMod.targets" Condition="'$(TmlInstallPath)' != ''" />
  <Import Project="../tModLoader.targets" Condition="'$(TmlInstallPath)' == '' and Exists('../tModLoader.targets')" />
</Project>
